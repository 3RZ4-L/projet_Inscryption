@startuml

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package cartes {
    class Carte {
        - m_nom String
        - m_pv Interger
        + <<create>> arte(String nom, Interger pdv)
        + getPv() Interger
        + toString() String
    }

    class Animal extends Carte{
        - m_attaque Interger
        - m_gouttes_sang Interger
        - m_os Interger
        - m_volant Boolean
        + <<create>> Animal(String nom, Interger pdv, Interger att, Interger gds, Interger os)
        + attaque(Animal adversaire) Boolean
        + attaque(Obstacle obstacle) Boolean
    }

    class Obstacle extends Carte{
        + Obstacle(String nom, Interger pdv)
    }
}

package mecaniques.affichage {
    class Affichage {
        + afficherLigne(String[][] cartes)
        + emptyCard() String[]
        + coordCard() String[]
        + animCard() String[]
        + affArrowUp() String[]
        + affArrowDown() String[]
    }
    class CreateArrow{
        - m_width Interger
        + arrowUp() String
        + arrowDown() String
        + arrowBody() String
    }
    class CreateCard{
        - m_width Interger
        + emptyTopBottom() String
        + emptyMiddle() String
        + corrdinate(coord String) String
        + animTopBottom() String
        + separate() String
        + animMiddle() String
        + animName(String nom) String
        + animHp(String hp) String
        + animDMG(String dmg) String
    }
}
package mecaniques.joueurs{
    class Pioche {
        + <<create>> Pioche()
        + piocher() Animal
        + melanger(Interger n)
    }

    class Joueur{
        - m_main Animal[*]
        - m_os Interger
        - m_goutteSang Interger
        + <<create>> Joueur()
        + piocher()
        + poser()
        + sacrifier()
    }
    class Adversaire extends Joueur{

    }
}
package mecaniques.battle{
    class Battle{
        - m_cartesJoueur Carte[*]
        - m_cartesAdversaire Carte[*]
        - m_score Interger
        + <<create>> Battle()
        + getCartesJoueur() Carte[]
        + getCartesAdversaire() Carte[]
        + getScore() Interger
        + joueurGagne() Boolean
        + adversaireGagne() Boolean
        + validPlacementAdversaire() Boolean
        + validPlacementJoueur() Boolean
    }
}
package mecaniques.jeu{
    class Ligne{
        + estCaseVide(Interger numCarte) : Boolean
        + retirerCarte(Interger numCarte) : Boolean
        + ajouterCarte(Interger numCarte, Animal carte) : Boolean
        + supprimerCarte(Interger numCarte) : Boolean
        + sacrifierCare(Interger numCarte) : Boolean
    }
    class Partie{
        + m_score Interger
        + m_numeroPartie Interger
        - <<create>> Partie()
        - demarrer()
        - tourJoueur()
        - tourAdversaire()
        - verfierFinPartie() : Boolean
        - getScore() : Interger
    }
}

class Main {
    +static void main(String[] args)
}

Affichage ..> CreateArrow : <<uses>>
Affichage ..> CreateCard : <<uses>>
Pioche <-* "-m_piche\n 0..*" Animal
Pioche *-> "-m_pioche \n 1" Joueur
Joueur *-> "-m_cartes\n ..4" Ligne
Joueur *-> "-m_joueur\n 1" Partie
Adversaire *-> "-m_adversaire\n 1" Partie

@enduml