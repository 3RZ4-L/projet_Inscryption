@startuml

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package mecaniques.cartes {
    class Carte {
        - m_nom : String
        - m_pv : Integer
        + <<create>> Carte(nom : String, pdv : Integer)
        + getPv() : Integer
        + toString() : String
    }

    class Animal extends Carte{
        - m_attaque : Integer
        - m_gouttes_sang : Integer
        - m_os Integer
        - m_volant : Boolean
        + <<create>> Animal(nom : String, pdv : Integer, att : Integer, gds : Integer, os : Integer)
        + attaque(adversaire : Animal) : Boolean
        + attaque(obstacle : Obstacle) : Boolean
    }

    class Obstacle extends Carte{
        + Obstacle(nom : String, pdv : Integer)
    }
}

package affichage {
    class AffichageGrid {
        + afficherLigne(cartes : String[][])
        + emptyCard() : String[]
        + coordCard() : String[]
        + animCard() : String[]
        + affArrowUp() : String[]
        + affArrowDown() : String[]
    }
    class CreateArrow{
        - m_width Integer
        + arrowUp() : String
        + arrowDown() : String
        + arrowBody() : String
    }
    class CreateCard{
        - m_width Integer
        + emptyTopBottom() : String
        + emptyMiddle() : String
        + corrdinate(coord : String) : String
        + animTopBottom() : String
        + separate() : String
        + animMiddle() : String
        + animName(nom : String) : String
        + animHp(hp : String) : String
        + animDMG(dmg : String) : String
    }
    class AffichageBattle{
        + attackDirect(cart : Carte, dmg : Integer)
        + attackCart(cart: Carte, other: Carte)
        + died(cart: Carte)
        + score(score: Integer)
    }
    class AffichagePioche{
        + afficherMain(j : Joueur)
        + afficherInfoCart(num : Integer, carte : Carte)
        + afficherPioche(p : Pioche)
        + afficherInterfacePioche(p : Pioche, j : Joueur)
    }
}
package mecaniques.joueurs{
    class Pioche {
        + <<create>> Pioche()
        + piocher() : Animal
        + melanger(n : Integer)
    }

    class Joueur{
        - m_os : Integer
        - m_goutteSang : Integer
        + <<create>> Joueur()
        + piocher()
        + poser()
        + sacrifier()
    }
    class Adversaire extends Joueur{
        + <<create>> Adversaire
    }
}
package mecaniques.battle{
    class Battle{
        - m_score : Integer
        + <<create>> Battle()
        + getCartesJoueur() : Carte[]
        + getCartesAdversaire() : Carte[]
        + getScore() : Integer
        + joueurGagne() : Boolean
        + adversaireGagne() : Boolean
        + validPlacementAdversaire() : Boolean
        + validPlacementJoueur() : Boolean
    }
}
package mecaniques.jeu{
    class Ligne{
        + estCaseVide(numCarte : Integer) : Boolean
        + retirerCarte(numCarte : Integer) : Boolean
        + ajouterCarte(numCarte : Integer, carte : Animal) : Boolean
        + supprimerCarte(numCarte : Integer) : Boolean
        + sacrifierCare(numCarte : Integer) : Boolean
    }
    class Partie{
        + m_score Integer
        + m_numeroPartie Integer
        - <<create>> Partie()
        - demarrer()
        - tourJoueur()
        - tourAdversaire()
        - verfierFinPartie() : Boolean
        - getScore() : Integer
    }
}

class Main {
    +static void main(String[] args)
}

AffichageGrid ..> CreateArrow : <<uses>>
AffichageGrid ..> CreateCard : <<uses>>
AffichageGrid ..> AffichagePioche : <<uses>>
AffichageGrid ..> AffichageBattle : <<uses>>
AffichageBattle .> Joueur : <<use>>
AffichagePioche .> Joueur : <<use>>
Pioche *-> "-m_pioche\n 0..*" Animal
Pioche <-* "-m_pioche \n 1" Joueur
Joueur *-> "-m_cartes\n ..4" Ligne
Joueur <-* "-m_joueur\n 1" Partie

@enduml