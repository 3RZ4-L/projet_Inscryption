@startuml

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

enum mecaniques.cartes.Pouvoirs <<enumerate>> {
    NULL
    NOMBREUSES_VIES
    CROISSANCE
    PUANT
    COUREUR
    CONTACT_MORTEL
    PIQUES_POINTUES
    - m_nom : String
    + getNom() : String
}

package mecaniques.cartes {
    abstract class Carte <<abstract>> {
        - m_nom : String
        - m_points_de_vie : int
        + <<create>> Carte(nom : String, pdv : int)
        + getPv() : int
        + getNom() : String
        + estMort() : boolean
        + doDamage(other : Carte) : int
        + attaqueDirect() : int
        + getAttack() : int
        + estVolant() : boolean
        + getNamePouvoir() : String
        + getPouvoir() : Pouvoirs
        + estCreature() : boolean
    }

    class Animal extends Carte {
        - m_attaque : int
        - m_gouttes_sang : int
        - m_os : int
        - m_volant : boolean
        - m_pouvoir : Pouvoirs
        + <<create>> Animal(nom : String, pdv : int, att : int, gds : int, os : int, volant : boolean)
        + <<create>> Animal(nom : String, pdv : int, att : int, gds : int, os : int, volant : boolean, power : Pouvoirs)
        + getAttack() : int
        + getGouttesSang() : int
        + getOs() : int
        + estVolant() : boolean
        + doDamage(other : Carte) : int
        + attaqueDirect() : int
        + getNamePouvoir() : String
        + getPouvoir() : Pouvoirs
        + estCreature() : boolean
    }

    class Obstacle extends Carte {
        + <<create>> Obstacle(nom : String, pdv : int)
        + estCreature() : boolean
    }
}

package mecaniques.joueurs {
    class Pioche {
        - m_pioche : Stack<Animal>
        + <<create>> Pioche(n : int)
        + melanger(n : int) : void
        + piocher() : Animal
        + ajouter(carte : Animal) : void
        + getNbCartes() : int
    }

    class Joueur {
        - m_pioche : Pioche
        - m_main : ArrayList<Animal>
        - m_ligne : Ligne
        - m_os : int
        - m_goutteSang : int
        + <<create>> Joueur()
        + croissance() : void
        + piocher() : void
        + ajouterDansPioche(carte : Animal) : void
        + placer(numCarte : int, position : int) : void
        + sacrifier(numCarte : int, position : int) : void
        + getNbMain() : int
        + getNbPioche() : int
        + getOs() : int
        + getGoutteSang() : int
        + getMain() : ArrayList<Animal>
        + getLigne() : Ligne
    }

    class Adversaire extends Joueur {
        + <<create>> Adversaire()
        + jouerTour(ligne : Ligne) : void
        - peutPiocher() : void
        + choisirPosition(ligne : Ligne) : int
        + searchEnemyCard(ligne : Ligne) : int
        + emptyPlace() : int
        + cartChois(position : int, ligne : Ligne) : int
        + placeDefense() : int
        + placeAttacker() : int
        + placeCart(idCart : int, position : int) : boolean
    }
}

package mecaniques.jeu {
    class Ligne {
        - m_cartes : Carte[4]
        + <<create>> Ligne()
        + estCaseVide(numCarte : int) : boolean
        + placerCarte(carte : Carte, position : int) : boolean
        + sacrifier(position : int) : boolean
        + croissance() : void
        + courrir(position : int) : boolean
        + getCartes() : Carte[*]
    }

    class Partie {
        - m_joueur : Joueur
        - m_adversaire : Joueur
        - m_score : int
        + <<create>> Partie()
        + demarrer() : int
        + tourJoueur() : void
        + tourAdversaire() : void
        + getScore() : int
        + commencerAttaques(attaquant : Ligne, defenseur : Ligne) : int
    }
}

package affichage {
    class CreateCard {
        - m_width : int = 18
        + emptyTopBottom() : String
        + emptyMiddle() : String
        + coordinate(coord : String) : String
        + animTopBottom() : String
        + separate() : String
        + animMiddle() : String
        + animName(cart : Carte) : String
        + animHP(cart : Carte) : String
        + animDMG(cart : Carte) : String
        + pouvoir(cart : Carte) : String
    }

    class CreateArrow {
        - m_width : int = 19
        + arrowUp() : String
        + arrowDown() : String
        + arrowBody() : String
    }

    class AffichageJeu {
        + afficherPlateau(joueur : Joueur, adversaire : Adversaire, numPartie : int, score : int) : void
        + afficherLigneCart(ligne : Ligne, lettre : String) : void
        + afficherLigneArrow(up : boolean) : void
        + afficherMainEtPioche(joueur : Joueur) : void
        - LaMain(joueur : Joueur) : String[*]
        - LaPioche(nbCartes : int) : String[*]
        + emptyCard() : String[*]
        + coordCard(coord : String) : String[*]
        + animCard(carte : Carte) : String[*]
        + arrowsUp() : String[][]
        + arrowsDown() : String[][]
    }

    class AffichageCommandes {
        + affActions() : void
        + affErrPiocher() : void
        + affErrSacrificer() : void
    }

    class AffichagePioche {
        + afficherMain(j : Joueur) : void
        + afficherInfoCart(num : int, anim : Animal) : void
        + afficherPioche(p : Pioche) : void
        + afficherInterfacePioche(p : Pioche, j : Joueur) : void
    }

    class Messages {
        + attackDirect(cart : Carte, dmg : int) : void
        + attackCart(cart : Carte, other : Carte) : void
        + died(cart : Carte) : void
        + score(score : int) : void
    }
}

package affichage.gestionEntrees {
    class Commande {
        - m_commande : String
        - m_position : String
        - m_numeroCarte : String
        - m_sacrifices : List<String>
        + <<create>> Commande()
        + estValide(nbCarteMax : int, piocher : boolean) : boolean
        + getCommande() : String
        + getPosition() : int
        + getNumeroCarte() : int
        + getSacrifices() : List<String>
    }

    class Choix {
        - m_choix : Animal
        + <<create>> Choix(pioche : Pioche)
        - estValide(entree : String) : boolean
        + getChoix() : Animal
    }
}

class Main {
    + {static} main(args : String[*]) : void
}

Partie *-- "1" Joueur : m_joueur
Partie *-- "1" Adversaire : m_adversaire
Joueur *-- "1" Pioche : m_pioche
Joueur *-- "1" Ligne : m_ligne
Joueur *-- "0..*" Animal : m_main
Pioche *-- "0..*" Animal : m_pioche
Ligne *-- "0..4" Carte : m_cartes
AffichageJeu *-- "1" CreateCard : m_createCard
AffichageJeu *-- "1" CreateArrow : m_createArrow
Choix o-- "1" Animal : m_choix
Carte o.. "0..1" Pouvoirs : m_pouvoir

Main ..> AffichageCommandes : <<use>>
Main ..> AffichagePioche : <<use>>
Main ..> AffichageJeu : <<use>>
Main ..> Joueur : <<use>>
Main ..> Adversaire : <<use>>
Main ..> Pioche : <<use>>
Partie ..> Commande : <<use>>
Partie ..> Choix : <<use>>
Partie ..> Pioche : <<use>>
Adversaire ..> Ligne : <<use>>
Joueur ..> Pioche : <<use>>
AffichageJeu ..> Joueur : <<use>>
AffichageJeu ..> Adversaire : <<use>>
AffichageJeu ..> Ligne : <<use>>
AffichagePioche ..> Joueur : <<use>>
AffichagePioche ..> Pioche : <<use>>
AffichagePioche ..> Animal : <<use>>
Pioche ..> Animal : <<Instantiate>>
Choix ..> Pioche : <<use>>

@enduml