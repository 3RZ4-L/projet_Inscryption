@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

enum mecaniques.cartes.Pouvoirs <<enumerate>> {
    NULL
    NOMBREUSES_VIES
    CROISSANCE
    PUANT
    COUREUR
    CONTACT_MORTEL
    PIQUES_POINTUES
    - m_nom : String
    + getNom() : String
}

package mecaniques.cartes {
    abstract class Carte <<abstract>> {
        - m_nom : String
        - m_points_de_vie : int
        + <<create>> Carte(nom : String, pdv : int)
        + getPv() : int
        + getNom() : String
        + estMort() : boolean
        + doDamage(other : Carte) : int
        + attaqueDirect() : int
        + getAttack() : int
        + estVolant() : boolean
        + getNamePouvoir() : String
        + getPouvoir() : Pouvoirs
        + estCreature() : boolean
    }

    class Animal extends Carte {
        - m_attaque : int
        - m_gouttes_sang : int
        - m_os : int
        - m_volant : boolean
        + <<create>> Animal(nom : String, pdv : int, att : int, gds : int, os : int, volant : boolean)
        + <<create>> Animal(nom : String, pdv : int, att : int, gds : int, os : int, volant : boolean, power : Pouvoirs)
        + getAttack() : int
        + getGouttesSang() : int
        + getOs() : int
        + estVolant() : boolean
        + doDamage(other : Carte) : int
        + attaqueDirect() : int
        + getNamePouvoir() : String
        + getPouvoir() : Pouvoirs
        + estCreature() : boolean
    }

    class Obstacle extends Carte {
        + <<create>> Obstacle(nom : String, pdv : int)
        + estCreature() : boolean
    }
}

package mecaniques.joueurs {
    class Pioche {
        + <<create>> Pioche(n : int)
        + melanger(n : int) : void
        + piocher() : Animal
        + ajouter(carte : Animal) : void
        + getNbCartes() : int
    }

    class Joueur {
        - m_os : int
        - m_goutteSang : int
        + <<create>> Joueur()
        + croissance() : void
        + piocher() : void
        + ajouterDansPioche(carte : Animal) : void
        + placer(numCarte : int, position : int) : void
        + sacrifier(numCarte : int, position : int) : void
        + getNbMain() : int
        + getNbPioche() : int
        + getOs() : int
        + getGoutteSang() : int
        + getMain() : ArrayList<Animal>
        + getLigne() : Ligne
    }

    class Adversaire extends Joueur {
        - <<create>> Adversaire()
        - jouerTour(ligne : Ligne) : void
        + peutPiocher() : void
        + choisirPosition(ligne : Ligne) : int
        + searchEnemyCard(ligne : Ligne) : int
        + emptyPlace() : int
        + cartChois(position : int, ligne : Ligne) : int
        + placeDefense() : int
        + placeAttacker() : int
        + placeCart(idCart : int, position : int) : boolean
    }
}

package mecaniques.jeu {
    class Ligne {
        + <<create>> Ligne()
        + estCaseVide(numCarte : int) : boolean
        + placerCarte(carte : Carte, position : int) : boolean
        + sacrifier(position : int) : boolean
        + croissance() : void
        + courrir(position : int) : boolean
        + getCartes() : Carte[*]
    }

    class Partie {
        - m_score : int
        + <<create>> Partie()
        + demarrer() : int
        + tourJoueur() : void
        + tourAdversaire() : void
        + getScore() : int
        + commencerAttaques(attaquant : Ligne, defenseur : Ligne) : int
    }
}

package affichage {
    class CreateCard {
        - m_width : int
        + emptyTopBottom() : String
        + emptyMiddle() : String
        + coordinate(coord : String) : String
        + animTopBottom() : String
        + separate() : String
        + animMiddle() : String
        + animName(cart : Carte) : String
        + animHP(cart : Carte) : String
        + animDMG(cart : Carte) : String
        + pouvoir(cart : Carte) : String
    }

    class CreateArrow {
        - m_width : int
        + arrowUp() : String
        + arrowDown() : String
        + arrowBody() : String
    }

    class AffichageJeu {
        + afficherPlateau(joueur : Joueur, adversaire : Adversaire, numPartie : int, score : int) : void
        + afficherLigneCart(ligne : Ligne, lettre : String) : void
        + afficherLigneArrow(up : boolean) : void
        + afficherMainEtPioche(joueur : Joueur) : void
        - LaMain(joueur : Joueur) : String[*]
        - LaPioche(nbCartes : int) : String[*]
        + emptyCard() : String[*]
        + coordCard(coord : String) : String[*]
        + animCard(carte : Carte) : String[*]
        + arrowsUp() : String[][]
        + arrowsDown() : String[][]
    }

    class AffichageCommandes {
        + affActions() : void
        + affErrPiocher() : void
        + affErrSacrificer() : void
    }

    class Messages {
        + attackDirect(cart : Carte, dmg : int) : void
        + attackCart(cart : Carte, other : Carte) : void
        + died(cart : Carte) : void
        + score(score : int) : void
    }
}

package affichage.gestionEntrees {
    class Commande {
        - m_commande : String
        - m_position : String
        - m_numeroCarte : String
        - m_sacrifices : List<String>
        + <<create>> Commande()
        + estValide(nbCarteMax : int, piocher : boolean) : boolean
        + getCommande() : String
        + getPosition() : int
        + getNumeroCarte() : int
        + getSacrifices() : List<String>
    }

    class Choix {
        + <<create>> Choix(pioche : Pioche)
        - estValide(entree : String) : boolean
        + getChoix() : Animal
    }
}

class Main {
    + {static} main(args : String[*]) : void
}

Main ..> Partie : <<Instantiate>>

Partie *--> "- m_joueur/n 1" Joueur
Partie *--> "- m_adversaire/n 1" Adversaire
Partie ..> Commande : <<use>>
Partie ..> Choix : <<use>>

Joueur *--> "- m_pioche \n >1" Pioche
Joueur *--> "- m_ligne \n 1" Ligne
Joueur *--> "- m_main \n *" Animal

Ligne *--> "-m_cartes /n 4" Carte
Pioche ..> Animal : <<Instantiate>>
Pioche *--> "- m_pioche \n *" Animal

AffichageJeu *--> "- m_createArrow \n 1" CreateCard : uses
AffichageJeu *--> "- m_createCard  \n 1" CreateArrow : uses
AffichageJeu ..> Joueur : <<use>>
AffichageJeu ..> Adversaire : <<use>>
AffichageJeu ..> Ligne : <<use>>

Choix o--> "- m_choix \n 1" Animal

Carte o..> "- m_pouvoir \n 0, 1" Pouvoirs

@enduml