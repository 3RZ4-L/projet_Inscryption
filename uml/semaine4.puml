@startuml

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package "affichage.gestionEntrees" {
    class Choix {
        - m_choix : Animal
        - sacrifice : Integer
        + <<create>> Choix(joueur : Joueur, carte1 : Animal, carte2 : Animal)
        + estValide(entree : String) : Boolean
        + getChoix() : Animal
    }
    
    class Commande {
        - m_commande : NomCommande
        - m_position : Integer
        - m_numeroCarte : Integer
        - m_sacrifices : List<Integer>
        + <<create>> Commande()
        + estValide(nbCarteMax : Integer, aPiochee : Boolean) : Boolean
        + getCommande() : NomCommande
        + getPosition() : Integer
        + getNumeroCarte() : Integer
        + getSacrifices() : List<Integer>
        + pause() : void
        + errPlacer() : void
    }
    
    enum NomCommande <<enumerate>> {
        FIN
        PIOCHER
        PLACER
        SACRIFIER
        + fromString(texte : String) : NomCommande
    }
}

package "mecaniques.cartes" {
    abstract class Carte <<abstract>> {
        - m_nom : String
        - m_points_de_vie : Integer
        + <<create>> Carte(nom : String, pdv : Integer)
        + getPv() : Integer
        + getNom() : String
        + estMort() : Boolean
        + doDamage(other : Carte) : Integer
        + {abstract} attaqueDirect() : Integer
        + {abstract} getAttack() : Integer
        + {abstract} estVolant() : Boolean
        + {abstract} getNamePouvoir() : String
        + {abstract} aPouvoir(pouvoir : Pouvoirs) : Boolean
        + {abstract} getPouvoir() : Optional<Pouvoirs>
        + {abstract} estCreature() : Boolean
        + {abstract} croissance() : Optional<Carte>
    }

    class Animal extends Carte {
        - m_attaque : Integer
        - m_gouttes_sang : Integer
        - m_os : Integer
        - m_volant : Boolean
        - m_pouvoir : ArrayList<Pouvoirs>
        + <<create>> Animal(nom : String, pdv : Integer, att : Integer, gds : Integer, os : Integer, volant : Boolean, power : Pouvoirs)
        + <<create>> Animal(nom : String, pdv : Integer, att : Integer, gds : Integer, os : Integer, volant : Boolean)
        + getAttack() : Integer
        + getGouttesSang() : Integer
        + getOs() : Integer
        + estVolant() : Boolean
        + doDamage(other : Carte) : Integer
        + attaqueDirect() : Integer
        + estCreature() : Boolean
        + getNamePouvoir() : String
        + getPouvoir() : Optional<Pouvoirs>
        + aPouvoir() : Boolean
        + aPouvoir(pouvoir : Pouvoirs) : Boolean
        + ajouterPouvoir(pouvoir : Pouvoirs) : void
        + croissance() : Optional<Carte>
    }

    class Obstacle extends Carte {
        + <<create>> Obstacle(nom : String, pdv : Integer)
        + estCreature() : Boolean
        + attaqueDirect() : Integer
        + getAttack() : Integer
        + estVolant() : Boolean
        + getNamePouvoir() : String
        + getPouvoir() : Optional<Pouvoirs>
        + aPouvoir(pouvoir : Pouvoirs) : Boolean
        + croissance() : Optional<Carte>
    }

    class CarteFactory {
        - RAND : Random
        - ANIMAUX_AVEC_POUVOIR : Animal[*]
        - ANIMAUX_SANS_POUVOIR : Animal[*]
        + getDeuxAnimaux() : Animal[*]
        + getCarteAleatoire() : Animal
    }

    enum Pouvoirs <<enumerate>> {
        NULL
        NOMBREUSES_VIES
        CROISSANCE
        PUANT
        COUREUR
        CONTACT_MORTEL
        PIQUES_POINTUES
        - m_nom : String
        + <<create>> Pouvoirs(nm : String)
        + getNom() : String
    }
}

package "affichage" {
    class AffichageJeu {
        - m_createArrow : CreateArrow
        - m_createCard : CreateCard
        + afficherPlateau(joueur : Joueur, adversaire : Adversaire, numPartie : Integer, numTour : Integer, score : Integer) : void
        + afficherLigneCart(ligne : Ligne, lettre : String) : void
        + afficherLigneArrow(up : Boolean) : void
        + afficherMainEtPioche(joueur : Joueur) : void
        + Consignes() : void
        + emptyCard() : String[*]
        + coordCard(coord : String) : String[*]
        + animCard(carte : Carte) : String[*]
        + LaMain(joueur : Joueur) : String[*]
        + LaPioche(nbCartes : Integer) : String[*]
        + arrowsUp() : String[*][*]
        + arrowsDown() : String[*][*]
    }
    
    class AffichagePioche {
        + afficherMain(j : Joueur) : void
        + afficherInfoCart(num : Integer, anim : Animal) : void
        + afficherPioche(p : Pioche) : void
        + afficherInterfacePioche(p : Pioche, j : Joueur) : void
    }
    
    class CreateArrow {
        - m_width : Integer
        + arrowUp() : String
        + arrowDown() : String
        + arrowBody() : String
    }
    
    class CreateCard {
        - m_width : Integer
        + emptyTopBottom() : String
        + emptyMiddle() : String
        + coordinate(coord : String) : String
        + animTopBottom() : String
        + separate() : String
        + animMiddle() : String
        + animName(cart : Carte) : String
        + animHP(cart : Carte) : String
        + animDMG(cart : Carte) : String
        + pouvoir(cart : Carte) : String
    }
    
    class Messages {
        + attackDirect(cart : Carte, dmg : Integer) : void
        + attackCart(cart : Carte, other : Carte) : void
        + died(cart : Carte) : void
        + score(score : Integer) : void
    }
}

package "mecaniques.joueurs" {
    class Pioche {
        - m_pioche : Stack<Animal>
        + <<create>> Pioche(n : Integer)
        + piocher() : Animal
        + ajouter(carte : Animal) : void
        + getNbCartes() : Integer
    }

    class Joueur {
        - m_pioche : Pioche
        - m_main : ArrayList<Animal>
        - m_ligne : Ligne
        - m_os : Integer
        - m_goutteSang : Integer
        + <<create>> Joueur()
        + piocher() : void
        + ajouterDansMain(carte : Animal) : void
        + placer(numCarte : Integer, position : Integer) : Boolean
        + sacrifier(position : Integer) : void
        + PierreDeSacrifice(position : Integer) : Optional<Pouvoirs>
        + peutSacrifier(position : Integer) : Boolean
        + croissanceDuLouveteau() : void
        + tuerAdversaire() : void
        + getNbMain() : Integer
        + getNbPioche() : Integer
        + getOs() : Integer
        + getGoutteSang() : Integer
        + getMain() : ArrayList<Animal>
        + getLigne() : Ligne
    }
    
    class Adversaire extends Joueur {
        - m_ligneAnnonce : Ligne
        + <<create>> Adversaire()
        + showNextCarts(ligne : Ligne) : void
        + jouerTour() : void
        + peutPiocher() : void
        + choisirPositionAnnonce(ligne : Ligne) : Integer
        + searchEnemyCard(ligne : Ligne) : Integer
        + emptyPlaceAnnonce() : Integer
        + cartChois(position : Integer, ligne : Ligne) : Integer
        + placeDefense() : Integer
        + placeAttacker() : Integer
        + placeCartAnnonce(idCart : Integer, position : Integer) : Boolean
        + annonceToBattle() : void
    }
    
    class Humain extends Joueur {
        + <<create>> Humain()
    }
    
    class Ligne {
        - m_cartes : Optional<Carte>[*]
        + <<create>> Ligne()
        + estCaseVide(numCarte : Integer) : Boolean
        + placerCarte(carte : Carte, position : Integer) : Boolean
        + sacrifier(position : Integer) : Boolean
        + estSacrifiable(position : Integer) : Boolean
        + PierreDeSacrifice(position : Integer) : Optional<Pouvoirs>
        + croissance() : void
        + attaquer(joueur : Joueur, defenseur : Ligne) : Integer
        + courrir(position : Integer) : Boolean
        + getLigne() : Optional<Carte>[*]
        + removeCart(place : Integer) : void
        + estVide() : Boolean
        + getCarte(position : Integer) : Optional<Carte>
    }
}

package "mecaniques.jeu" {
    class Partie {
        - m_joueur : Humain
        - m_adversaire : Adversaire
        - m_score : Integer
        - m_tour : Integer
        - m_partie : Integer
        + <<create>> Partie()
        + demarrer() : Integer
        + tourJoueur() : void
        + tourAdversaire() : void
        + getScore() : Integer
        + getNumParte() : Integer
        + getNumTour() : Integer
        + commencerAttaques(joueur1 : Joueur, joueur2 : Joueur) : Integer
    }
}

class Main {
    + {static} main(args : String[*]) : void
}

Main ..> Partie : <<use>>
Partie ..> Commande : <<use>>
Partie ..> Choix : <<use>>
Partie ..> AffichageJeu : <<use>>
Partie --> Humain : has
Partie --> Adversaire : has
AffichageJeu ..> CreateArrow : <<use>>
AffichageJeu ..> CreateCard : <<use>>
AffichageJeu ..> Ligne : <<use>>
AffichageJeu ..> Joueur : <<use>>
AffichageJeu ..> Adversaire : <<use>>
AffichagePioche ..> Joueur : <<use>>
Messages ..> Carte : <<use>>
Choix ..> Animal : <<creates>>
Choix ..> Joueur : <<use>>
Commande ..> NomCommande : <<use>>
Joueur *--> Pioche : has
Joueur *--> Ligne : has
Joueur --> Animal : holds
Adversaire --> Ligne : m_ligneAnnonce
CarteFactory ..> Animal : <<creates>>
Carte <|-- Animal
Carte <|-- Obstacle
Joueur <|-- Adversaire
Joueur <|-- Humain

@enduml